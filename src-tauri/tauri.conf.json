{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeKeeper",
  "version": "0.1.1",
  "identifier": "com.fahad.timekeeper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TimeKeeper",
        "width": 220,
        "height": 220,
        "minWidth": 220,
        "maxWidth": 220,
        "minHeight": 220,
        "maxHeight": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
